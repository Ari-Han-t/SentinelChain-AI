ENVIRONMENT=development
DATABASE_URL=sqlite:///./sentinelchain.db
JWT_SECRET=change-me-to-a-long-random-value
JWT_TTL_MINUTES=30
IMPORT_HMAC_SECRET=change-me-import-key
FIELD_ENCRYPTION_KEY=change-me-encryption-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
SEED_DEMO_DATA=true
# Required together when starting a new production database:
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-with-12-plus-characters
VITE_API_URL=http://localhost:8000

# Azure AI Foundry model inference is backend-only. Put real values in .env,
# never in this tracked example file and never in a VITE_ variable.
# Endpoint example: https://your-resource.services.ai.azure.com/models
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1200
AZURE_AI_FOUNDRY_ENABLED=false
AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=<deployment-name>
AZURE_AI_FOUNDRY_TIMEOUT_SECONDS=30
AZURE_AI_FOUNDRY_MAX_TOKENS=1200
MONITORING_INTERVAL_SECONDS=3600

# Phase 3: backend-owned HTTPS profiles; browser receives profile name/system only.
INTEGRATION_PROFILES_JSON={}
# Example (replace placeholder host and provision the token outside source control):
# INTEGRATION_PROFILES_JSON={"erp-primary":{"system":"erp","base_url":"https://partner.example/api","token_env":"SENTINEL_INTEGRATION_ERP_TOKEN","timeout_seconds":10,"max_attempts":3}}
# SENTINEL_INTEGRATION_ERP_TOKEN=

# Phase 5 source/deadline checks run inside the API process (10–3600 seconds).
NOTIFICATION_INTERVAL_SECONDS=30
# Only the in_app notification channel is configured; no email provider is enabled.

# PostgreSQL pool sizing; per API process.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
# See .env.production.example and docs/DEPLOYMENT.md.
