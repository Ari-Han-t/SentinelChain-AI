# Copy to an untracked backend/.env or use deployment secret injection.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://sentinel_runtime:REPLACE_DATABASE_PASSWORD@db.example.com:5432/sentinelchain?sslmode=verify-full
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_32_CHARS_OR_MORE
JWT_TTL_MINUTES=30
IMPORT_HMAC_SECRET=REPLACE_WITH_SECOND_UNIQUE_RANDOM_SECRET_32_CHARS_OR_MORE
FIELD_ENCRYPTION_KEY=REPLACE_WITH_THIRD_UNIQUE_RANDOM_SECRET_32_CHARS_OR_MORE
DEMO_MODE=false
SEED_DEMO_DATA=false
CORS_ORIGINS=https://app.example.com
AI_PROVIDER=deterministic
RATE_LIMIT_PER_MINUTE=180
NOTIFICATION_INTERVAL_SECONDS=30
MONITORING_INTERVAL_SECONDS=3600
INTEGRATION_PROFILES_JSON={}
# Supply bootstrap credentials through the secret manager only on initial setup.
# BOOTSTRAP_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_UNIQUE_12_PLUS_CHARACTER_PASSWORD
